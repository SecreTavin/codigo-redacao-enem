---
import { stats } from '../data/content';
---

<section class="relative bg-ink text-paper">
  <div class="container-x py-16 sm:py-20">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <h2 class="h-display max-w-2xl text-3xl sm:text-4xl" data-reveal>
        A redação é a prova que mais derruba candidato. <span class="text-hl">E ela avisa antes.</span>
      </h2>
      <p class="text-sm text-paper/50" data-reveal>Dados oficiais · Fonte: Inep</p>
    </div>
    <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-3xl bg-paper/10 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class="bg-ink p-6 sm:p-8" data-reveal style={`--d:${i * 90}ms`}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="whitespace-nowrap font-display text-[2.6rem] leading-none font-semibold tabular-nums sm:text-6xl" data-count={s.value} data-decimals={s.decimals} data-suffix={s.suffix}>
              {s.value.toLocaleString('pt-BR')}{s.suffix}
            </span>
            <p class="mt-3 text-sm leading-snug text-paper/65">{s.label}</p>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
