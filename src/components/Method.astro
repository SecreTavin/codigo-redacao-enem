---
import { steps } from '../data/content';
import BuyButton from './BuyButton.astro';
---

<section class="relative border-y border-ink/10 bg-paper-2/60">
  <div class="container-x py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow text-pen" data-reveal>A solução</p>
      <h2 class="h-display mt-4 text-4xl sm:text-5xl" data-reveal>
        O Método Anti-Zero: <span class="whitespace-nowrap">3 etapas,</span> na ordem certa.
      </h2>
      <p class="mt-5 text-lg text-muted" data-reveal>Primeiro você para de perder pontos. Depois começa a ganhar.</p>
    </div>

    <ol class="relative mt-16 grid gap-6 md:grid-cols-3">
      <div class="absolute top-8 right-[16%] left-[16%] hidden h-0.5 bg-[repeating-linear-gradient(90deg,var(--color-ink)_0_8px,transparent_8px_16px)] opacity-20 md:block" aria-hidden="true"></div>
      {steps.map((s, i) => (
        <li class="card relative bg-paper" data-reveal style={`--d:${i * 120}ms`}>
          <div class="grid size-16 place-items-center rounded-2xl bg-ink font-display text-3xl font-semibold text-hl">{i + 1}</div>
          <p class="eyebrow mt-6 text-muted">{s.tag}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-14 flex flex-col items-center gap-3" data-reveal>
      <BuyButton source="method" />
      <p class="text-sm text-muted">Pagamento único · acesso após a confirmação</p>
    </div>
  </div>
</section>
