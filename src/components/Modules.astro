---
import { modules } from '../data/content';
---

<section class="bg-ink text-paper">
  <div class="container-x py-20 sm:py-28">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="eyebrow text-hl" data-reveal>O que tem dentro</p>
        <h2 class="h-display mt-4 max-w-2xl text-4xl sm:text-5xl" data-reveal>12 blocos objetivos. Nenhuma página enchendo linguiça.</h2>
      </div>
      <p class="max-w-xs text-paper/60" data-reveal>Cada bloco resolve um problema real de quem escreve no dia 8 de novembro.</p>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-paper/10 sm:grid-cols-2 lg:grid-cols-3">
      {modules.map(([title, text], i) => (
        <li class="group bg-ink p-6 transition-colors hover:bg-ink-2 sm:p-7" data-reveal style={`--d:${(i % 3) * 70}ms`}>
          <span class="font-display text-sm font-semibold text-hl tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-semibold">{title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-paper/60">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
