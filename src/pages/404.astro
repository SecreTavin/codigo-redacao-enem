---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — Código Redação" noindex>
  <main id="conteudo" class="grid min-h-dvh place-items-center px-5 text-center">
    <div>
      <p class="font-hand text-8xl text-red">0</p>
      <h1 class="h-display mt-2 text-4xl">Essa página fugiu do tema.</h1>
      <p class="mt-3 text-muted">O endereço que você acessou não existe.</p>
      <a href="/" class="btn-buy mt-8">Voltar para o início</a>
    </div>
  </main>
</Base>
