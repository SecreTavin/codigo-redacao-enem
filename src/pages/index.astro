---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Problem from '../components/Problem.astro';
import Method from '../components/Method.astro';
import Quiz from '../components/Quiz.astro';
import Modules from '../components/Modules.astro';
import Samples from '../components/Samples.astro';
import Compare from '../components/Compare.astro';
import Audience from '../components/Audience.astro';
import Offer from '../components/Offer.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { site } from '../config/site';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: site.productName,
  description: site.description,
  image: new URL('/og.png', Astro.site).href,
  brand: { '@type': 'Brand', name: 'Código Redação' },
  offers: {
    '@type': 'Offer',
    price: site.price.toFixed(2),
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: new URL('/', Astro.site).href,
  },
};
---

<Base jsonLd={productLd}>
  <Header />
  <main>
    <Hero />
    <Stats />
    <Problem />
    <Method />
    <Quiz />
    <Modules />
    <Samples />
    <Compare />
    <Audience />
    <Offer />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyBar />
</Base>

<script>
  import '../scripts/main.ts';
</script>
